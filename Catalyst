    border-bottom: 1px solid var(--border);
  }
  .signals-title {
    font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 16px;
  }
  .signals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px;
  }
  .signal-item {
    padding: 12px 14px;
    border-left: 2px solid;
    background: var(--surface);
    font-size: 11px;
    line-height: 1.5;
  }
  .signal-item.red { border-color: var(--red); }
  .signal-item.amber { border-color: var(--amber); }
  .signal-item.violet { border-color: var(--violet); }
  .signal-item.teal { border-color: var(--teal); }
  .signal-item.gold { border-color: var(--gold); }
  .signal-count { font-family: var(--serif); font-size: 22px; font-weight: 700; line-height: 1; }
  .signal-item.red .signal-count { color: var(--red); }
  .signal-item.amber .signal-count { color: var(--amber); }
  .signal-item.violet .signal-count { color: var(--violet); }
  .signal-item.teal .signal-count { color: var(--teal); }
  .signal-item.gold .signal-count { color: var(--gold); }
  .signal-label { color: var(--text2); margin-top: 4px; }

  /* ── SUMMARY BAR ── */
