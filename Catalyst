  }
  .venn-node-desc { font-size: 10px; color: var(--muted); line-height: 1.5; }
  .venn-node.nuc .venn-node-label, .venn-node.nuc .venn-node-count { color: var(--red); }
  .venn-node.aero .venn-node-label, .venn-node.aero .venn-node-count { color: var(--gold); }
  .venn-node.exotic .venn-node-label, .venn-node.exotic .venn-node-count { color: var(--violet); }
  .venn-node.intel .venn-node-label, .venn-node.intel .venn-node-count { color: var(--teal); }
  .venn-node.overlap .venn-node-label, .venn-node.overlap .venn-node-count { color: var(--amber); }

