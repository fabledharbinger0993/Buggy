function buildCard(c, eraIdx) {
  const statusMap = { dead:'Deceased', missing:'Missing', underground:'Withdrew/Deceased' };
  const warnBlock = (c.warned && c.warning && c.warning !== 'None documented.') ? `
    <div class="row"><div class="row-lbl">Pre-Death / Pre-Disappearance Statements</div>
    <div class="row-body">${c.warning}</div></div>` : '';
  const flagBlock = c.flag ? `<div class="flag">${c.overlap}</div>` : '';
  const overlapBlock = c.overlap && !c.flag ? `<div class="overlap-bar">${c.overlap}</div>` : '';
  const tags = c.tags.map(t => {
    const cl = (t.includes('uap')||t.includes('anti-grav')||t.includes('exotic')) ? 'v'
             : (t.includes('nuclear')||t.includes('weapon')||t.includes('bomb')) ? 'r'
             : (t.includes('nasa')||t.includes('jpl')||t.includes('afrl')||t.includes('aerospace')) ? 'gd'
             : (t.includes('warn')||t.includes('contest')||t.includes('flag')||t.includes('cluster')||t.includes('on-foot')) ? 'a'
             : 'g';
    return `<span class="tag ${cl}">${t.replace(/-/g,' ')}</span>`;
  }).join('');

  return `<div class="card ${c.status}" 
    data-status="${c.status}" 
    data-domain="${c.domain.join(' ')}" 
    data-flag="${c.flag}" 
    data-warned="${c.warned}">
    <div class="card-badge">${c.badge || statusMap[c.status]}</div>
    <div class="card-idx">${c.id}</div>
    <div class="card-name">${c.name}</div>
    <div class="card-role">${c.role}</div>
    <div class="card-when"><strong>${c.when}</strong></div>
    <div class="row"><div class="row-lbl">Area of Expertise</div><div class="row-body">${c.expertise}</div></div>
    <div class="row"><div class="row-lbl">Affiliation</div><div class="row-body">${c.affiliation}</div></div>
    <div class="row"><div class="row-lbl">Official Ruling</div><div class="row-body">${c.ruling}</div></div>
    <div class="row"><div class="row-lbl">Circumstances</div><div class="row-body">${c.circumstances}</div></div>
    ${warnBlock}
    ${flagBlock}${overlapBlock}
    <div class="tags">${tags}</div>
  </div>`;
}

function render() {
  const main = document.getElementById('main');
  let html = '';
  eras.forEach((era, ei) => {
    html += `<div class="era-block" id="${era.id}">
      <div class="era-header ${era.cls}">
        <div class="era-title">${era.label}</div>
        <div class="era-sub">${era.sub}</div>
      </div>
      <div class="grid era-grid" id="grid-${era.id}">`;
    era.cases.forEach(c => { html += buildCard(c, ei); });
    html += `</div></div>`;
  });
  main.innerHTML = html;
}

function filter(type, btn) {
  document.querySelectorAll('.fbtn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.card').forEach(card => {
    let show = false;
    const dom = card.dataset.domain || '';
    if (type === 'all') show = true;
    else if (type === 'dead') show = card.dataset.status === 'dead';
    else if (type === 'missing') show = card.dataset.status === 'missing';
    else if (type === 'nuclear') show = dom.includes('nuclear');
    else if (type === 'aerospace') show = dom.includes('aerospace');
    else if (type === 'exotic') show = dom.includes('exotic');
    else if (type === 'intel') show = dom.includes('intel');
    else if (type === 'flag') show = card.dataset.flag === 'true';
    else if (type === 'warned') show = card.dataset.warned === 'true';
    card.classList.toggle('h', !show);
  });
  // Hide empty era blocks
  document.querySelectorAll('.era-block').forEach(block => {
    const visible = block.querySelectorAll('.card:not(.h)').length > 0;
    block.classList.toggle('h', !visible);
  });
}

