  .stat-num { font-family: var(--serif); font-size: 32px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
  .stat-label { font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }
  .stat.d .stat-num { color: var(--red); }
  .stat.m .stat-num { color: var(--gold); }
  .stat.t .stat-num { color: #ede9df; }
  .stat.span .stat-num { color: var(--violet); }
  .stat.era .stat-num { color: var(--teal); }

  /* ── FILTER BAR ── */
  .filter-bar {
    padding: 14px 56px; border-bottom: 1px solid var(--border);
    display: flex; gap: 6px; flex-wrap: wrap; align-items: center;
    background: var(--surface);
    position: sticky; top: 0; z-index: 10;
