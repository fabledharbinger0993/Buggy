  .era-1 .era-title { color: var(--violet); }
  .era-2 .era-title { color: var(--teal); }
  .era-3 .era-title { color: var(--amber); }
  .era-4 .era-title { color: var(--gold); }

  /* ── GRID ── */
  .grid {
    padding: 2px 56px 2px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 2px;
  }
  .grid-gap { padding: 2px; }

  /* ── CARD ── */
  .card {
    background: var(--surface);
